# Listeners
ZCI_BIND=0.0.0.0:8443
ZCI_HTTP_BIND=0.0.0.0:8080
ZCI_QUIC_BIND=0.0.0.0:8443
ZCI_TLS_CERT=/certs/cert.pem
ZCI_TLS_KEY=/certs/key.pem

# Storage
DATABASE_URL=postgres://zci:zci@postgres:5432/zci
RETENTION_DAYS=30

# Tenant-scoped keys. Format: tenant:key;tenant2:key2
# Site keys are intentionally publishable to a first-party browser integration.
# Admin keys protect read/compare/client endpoints and must stay secret.
ZCI_SITE_KEYS=
ZCI_ADMIN_KEYS=

# Cross-origin SDK embedding. Comma-separated origins, no wildcard by default.
ZCI_CORS_ORIGINS=
ZCI_MAX_PROBE_BYTES=1048576

# Historical client graph
ZCI_GRAPH_WINDOW_DAYS=90
ZCI_GRAPH_CANDIDATE_LIMIT=1500
ZCI_GRAPH_MATCH_THRESHOLD=0.76
ZCI_GRAPH_MIN_CONFIDENCE=0.42

# Proxy handling. Forwarded client IP is accepted only from these peers.
TRUST_PROXY_HEADERS=false
ZCI_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128

# Optional offline CIDR enrichment database, see data/enrichment.example.json
ZCI_ENRICHMENT_DB=

# Optional Linux XDP TCP SYN sensor
ZCI_SENSOR_SOCKET=/run/zci/tcp-sensor.sock
ZCI_SENSOR_INTERFACE=eth0

RUST_LOG=client_intel_collector=info,tower_http=info
